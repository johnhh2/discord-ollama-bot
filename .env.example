# Copy this file to .env and fill it in. Never commit .env.

# Discord bot token (required) — https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Discord application client ID (optional; only !botinvitelink needs it) —
# Developer Portal → your application → General Information
DISCORD_CLIENT_ID=

# IP address of the machine running Ollama (Docker only)
# Leave unset if Ollama is running on the same host as Docker
# OLLAMA_HOST_IP=192.168.1.100

# Ollama model + default system prompt for !ask (optional)
# OLLAMA_MODEL=dolphin3:8b
# SYSTEM_PROMPT=You are a helpful assistant.

# Per-channel message history depth for AI context (optional)
# HISTORY_LIMIT=20

# Comma-separated channel IDs for passive AI responses (optional; all channels if unset)
# ACTIVE_CHANNEL_IDS=

# Comma-separated Discord user IDs granted the bot_admin permission tier
# BOT_ADMIN_IDS=

# NSFW image API (optional; enables !nsfw)
# NSFW_API_URL=
# NSFW_API_KEY=
# NSFW_API_USER_ID=

# Minecraft Bedrock server status (optional; unset MC_SERVER_HOST disables it).
# Use the external address players connect with (DDNS name or WAN IP) so !mc
# latency measures their route, not a ~0ms same-host hop. Needs router
# NAT-loopback; without it use host.docker.internal and accept local-only latency.
# MC_SERVER_HOST=yourname.ddns.net
# MC_SERVER_PORT=19132
# MC_POLL_SECONDS=60
# true shows the server address in !mc embeds and monitor alerts (hidden by
# default so it isn't leaked into Discord channels).
# MC_SERVER_SHOW_IP=false

# MariaDB connection (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=botuser
DB_PASSWORD=your_db_password_here
DB_NAME=discord_bot
