# Copy this to .env and fill in your values
DISCORD_TOKEN=your_discord_bot_token_here

# Ollama settings
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=dolphin3:8b

# Bot behaviour
# Comma-separated channel IDs the bot should respond in (leave empty to respond everywhere)
ACTIVE_CHANNEL_IDS=

# Number of messages to remember per channel (conversation memory)
HISTORY_LIMIT=20

# Seconds a user must wait between messages
RATE_LIMIT_SECONDS=5.0

# Default system prompt (can be overridden per channel with !setprompt)
SYSTEM_PROMPT=You are a helpful assistant.
