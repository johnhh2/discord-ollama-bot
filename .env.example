# Copy this file to .env and fill in your actual Discord token
# DO NOT commit .env to the repository

# Discord bot token (required)
# Get this from: https://discord.com/developers/applications
# IMPORTANT: Keep this secret! Never share or commit to version control
DISCORD_TOKEN=your_discord_token_here

# Discord application client ID (optional)
# Required only for the !botinvitelink command. Find it in the Discord
# Developer Portal under your application's "General Information" page.
DISCORD_CLIENT_ID=

# IP address of the machine running Ollama (Docker only)
# Leave unset if Ollama is running on the same host as Docker
# OLLAMA_HOST_IP=192.168.1.100

# Ollama model + default system prompt for !ask (optional)
# OLLAMA_MODEL=dolphin3:8b
# SYSTEM_PROMPT=You are a helpful assistant.

# Per-channel message history depth for AI context (optional)
# HISTORY_LIMIT=20

# Comma-separated channel IDs for passive AI responses (optional; all channels if unset)
# ACTIVE_CHANNEL_IDS=

# Comma-separated Discord user IDs granted the bot_admin permission tier
# BOT_ADMIN_IDS=

# NSFW image API (optional; enables !nsfw)
# NSFW_API_URL=
# NSFW_API_KEY=
# NSFW_API_USER_ID=

# Minecraft Bedrock server status (optional; leave MC_SERVER_HOST unset to
# disable). Use the server's EXTERNAL address (DDNS name or WAN IP) — the same
# one players connect with — so !mc latency reflects the real internet-facing
# route instead of a ~0ms same-host hop. Requires router NAT-loopback (most
# support it); if yours doesn't, use host.docker.internal instead and accept
# that latency is local-only.
# MC_SERVER_HOST=yourname.ddns.net
# MC_SERVER_PORT=19132
# MC_POLL_SECONDS=60
# Set to true to show the server address in !mc embeds and monitor alerts
# (hidden by default so the address isn't leaked into Discord channels).
# MC_SERVER_SHOW_IP=false

# MariaDB connection (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=botuser
DB_PASSWORD=your_db_password_here
DB_NAME=discord_bot
