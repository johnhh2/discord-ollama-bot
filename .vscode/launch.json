{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Bot (Docker)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose up --build",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Bot (Python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bot.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        }
    ]
}
